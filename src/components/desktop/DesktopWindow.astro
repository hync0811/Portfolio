---
import icEi from "../../assets/ic-ei.svg?url";
import arrowLeft from "../../assets/arrow-left.svg?url";
import arrowRight from "../../assets/arrow-right.svg?url";
import arrowUp from "../../assets/arrow-up.svg?url";
import refreshButton from "../../assets/refresh-btn.svg?url";
import searchIcon from "../../assets/ic-search.svg?url";
import closeIcon from "../../assets/ic-close.svg?url";
import pointRight from "../../assets/ic-point-right.svg?url";

interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---

<article class="window" id={id} data-draggable data-window>
  <header class="window__titlebar" data-drag-handle>
    <span>eiter</span>
    <button type="button" aria-label={`Close ${title}`} data-window-close><img src={closeIcon} alt="" /></button>
  </header>
  <div class="window__toolbar">
    <button class="window__toolbar-icon" type="button" data-window-back aria-label="Back"><img src={arrowLeft} alt="" /></button>
    <button class="window__toolbar-icon" type="button" data-window-forward aria-label="Forward"><img src={arrowRight} alt="" /></button>
    <button class="window__toolbar-icon window__toolbar-icon--up" type="button" data-window-up aria-label="Back to top"><img src={arrowUp} alt="" /></button>
    <button class="window__toolbar-icon" type="button" data-window-refresh aria-label="Refresh current section"><img src={refreshButton} alt="" /></button>
    <div class="window__address"><img src={icEi} alt="" /><img class="window__point-icon" src={pointRight} alt="" /><span data-window-address-title>{title}</span></div>
    <div class="window__search"><span>Searching</span><img src={searchIcon} alt="" /></div>
  </div>
  <div class="window__body">
    <aside aria-label="Sections">
      <a href="#about" data-window-target="about" class="is-active" aria-current="page"><img class="window__point-icon" src={pointRight} alt="" /><span class="window__nav-label">About me</span></a>
      <a href="#works" data-window-target="works"><img class="window__point-icon" src={pointRight} alt="" /><span class="window__nav-label">Works</span></a>
      <a href="#contact" data-window-target="contact"><img class="window__point-icon" src={pointRight} alt="" /><span class="window__nav-label">Contact</span></a>
    </aside>
    <section class="window__content">
      <div data-panel="about"><slot name="about" /></div>
      <slot name="works" />
      <slot name="contact" />
    </section>
  </div>
</article>

<style>
  .window { --sidebar-width: clamp(12.5rem, 13vw, 250px); --chrome-height: 140px; --window-height: min(862px, calc(100vh - 5rem)); --content-height: calc(var(--window-height) - var(--chrome-height)); position: absolute; top: clamp(1.5rem, 4vh, 3rem); left: calc(100% - 3rem); width: min(1331px, calc(100vw - clamp(15rem, 25vw, 29rem))); min-width: 0; height: var(--window-height); max-height: calc(100% - 2rem); overflow: hidden; translate: -100% 0; border-radius: var(--radius-window); background: var(--color-surface); box-shadow: 1rem 1rem 0 var(--color-purple); cursor: default; touch-action: none; }
  .window__titlebar { position: relative; display: flex; align-items: center; justify-content: space-between; height: 50px; padding: 0 1.25rem 0 3rem; color: var(--color-purple); background: var(--color-purple); font: 600 .8rem/1 var(--font-mono); cursor: grab; }
  .window__titlebar > span { position: absolute; z-index: 1; inset: 0 auto 0 0; display: grid; width: var(--sidebar-width); place-items: center; font-size: 26px; font-weight: 600; }
  .window__titlebar::before { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--sidebar-width); border-top-left-radius: var(--radius-window); border-top-right-radius: var(--radius-window); background: var(--color-mint); }
  .window__titlebar > * { position: relative; z-index: 1; }
  .window__titlebar:active { cursor: grabbing; }
  button { border: 0; color: var(--color-mint); background: transparent; font-size: 1.25rem; cursor: pointer; }
  button img { display: block; width: .85rem; height: .85rem; }
  .window__titlebar button { position: absolute; z-index: 2; top: 50%; right: 1.5rem; display: grid; width: 24px; height: 24px; place-items: center; padding: 0; translate: 0 -50%; }
  .window__titlebar button img { width: 18px; height: 18px; }
  .window__toolbar { display: grid; grid-template-columns: repeat(4, auto) minmax(14rem, 1fr) 13rem; align-items: center; gap: 1.25rem; height: 90px; padding: .75rem 1.5rem; border-bottom: 1px solid #9853E8; color: var(--color-purple); background: var(--color-mint); font: 600 1rem/1 var(--font-mono); }
  .window__toolbar-icon { display: grid; place-items: center; width: 24px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .window__toolbar-icon img { display: block; width: 24px; height: 24px; min-width: 24px; max-width: none; object-fit: contain; }
  .window__toolbar-icon--up img { width: 24px; height: 24px; }
  .window__toolbar div { overflow: hidden; padding: .75rem; border-radius: .65rem; color: var(--color-purple); background: var(--color-chrome); font-size: .72rem; white-space: nowrap; }
  .window__toolbar .window__address { display: flex; align-items: center; justify-content: left; gap: 1rem; min-height: 40px; margin-left: 3rem; font-size: 19px; }
  .window__toolbar .window__search { display: flex; align-items: center; justify-content: space-between; min-height: 40px; font-size: 19px; }
  .window__search span { opacity: .5; font-weight: 400; }
  .window__search img { width: 14px; height: 14px; object-fit: contain; }
  .window__address img, .window__address .window__point-icon { width: 14px; height: 14px; flex: 0 0 auto; object-fit: contain; }
  .window__address img:first-child { width: 18px; height: 18px; }
  aside .window__point-icon { width: 14px; height: 14px; }
  .window__body { display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); height: var(--content-height); }
  aside { display: flex; flex-direction: column; gap: 2rem; padding: 7rem 1.25rem 4rem; background: var(--color-mint); }
  aside a { display: flex; align-items: center; gap: .75rem; color: var(--color-purple); font: 700 24px/1 var(--font-mono); text-decoration: none; }
  .window__nav-label { padding: .35rem .5rem; border-radius: .3rem }
  .window__body > aside > a[aria-current="page"] .window__nav-label {
    display: inline-block;
    min-width: 5.65rem;
    color: var(--color-surface) !important;
    background: var(--color-purple) !important;
  }
  aside a:hover .window__nav-label, aside a:focus-visible .window__nav-label { color: var(--color-surface); background: color-mix(in srgb, var(--color-purple) 78%, transparent); }
  .window__content { width: auto; height: 100%; overflow: auto; padding: 0; border-left: 1px solid #9853E8; }
  @media (min-width: 48.01rem) and (min-resolution: 120dpi) and (max-resolution: 143dpi) { .window { --window-height: min(1000px, calc(100vh + 5rem)); width: min(2030px, calc(100vw - 10rem)); } }
  @media (max-width: 48rem) { .window { top: 5%; left: calc(100% - 2rem); width: calc(100vw - 2rem); min-width: 0; height: calc(100% - 2rem); } .window__toolbar { grid-template-columns: repeat(4, auto) 1fr; } .window__toolbar div:last-child { display: none; } .window__body { grid-template-columns: 1fr; height: calc(100% - 140px); } .window__content { width: 100%; height: auto; } aside { display: none; } }
</style>
