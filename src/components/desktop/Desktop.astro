---
import BrandMark from "../ui/BrandMark.astro";
import AboutPanel from "../about/AboutPanel.astro";
import ContactPanel from "../contact/ContactPanel.astro";
import DesktopWindow from "./DesktopWindow.astro";
import WorksPanel from "../works/WorksPanel.astro";
import audio01 from "../../assets/audio/01-Life-Is-Inexhaustible.mp3?url";
import audio02 from "../../assets/audio/02-Tomorrow-Never-Came.mp3?url";
import audio03 from "../../assets/audio/03-Hampstead.mp3?url";
import audio04 from "../../assets/audio/04-DtMF.mp3?url";
import audio05 from "../../assets/audio/05-The-Complete-Knock.mp3?url";
import audio06 from "../../assets/audio/06-My-Moon-My-Man.mp3?url";
import audio07 from "../../assets/audio/07-TAN-DU.mp3?url";
import audio08 from "../../assets/audio/08-My-Lucky-Stars.mp3?url";
import audio09 from "../../assets/audio/09-YM45-ITOSHIITOHOSHI.mp3?url";
import audio10 from "../../assets/audio/10-PINKY-UP.mp3?url";
import audio11 from "../../assets/audio/11-Back-To-Me.mp3?url";

const playlist = [
  ["Life Is Inexhaustible", "HOYO-MiX", audio01],
  ["Tomorrow Never Came", "Lana Del Rey", audio02],
  ["Hampstead", "Ariana Grande", audio03],
  ["DtMF", "Bad Bunny", audio04],
  ["The Complete Knock", "Blood Orange", audio05],
  ["My Moon My Man", "Feist", audio06],
  ["Tan Du", "Humm", audio07],
  ["My Lucky Stars", "Tupperwave", audio08],
  ["YM45 ITOSHIITOHOSHI", "Inko Saito", audio09],
  ["PINKY UP", "KATSEYE", audio10],
  ["Back To Me", "The Marías", audio11],
];
---

<main class="desktop" id="play" data-desktop>
  <div class="desktop__stage">
    <section class="desktop__playlist" aria-label="Now playing playlist" data-playlist data-draggable hidden>
      <div class="desktop__playlist-card">
        <audio data-audio-player preload="metadata" src={audio01}></audio>
        <header class="desktop__playlist-header" data-drag-handle><span>now playing</span><b aria-hidden="true"></b></header>
        <div class="desktop__playlist-record" aria-hidden="true"><i></i></div>
        <h2>eiter.exe //<br />tracklist</h2>
        <ol class="desktop__playlist-list" data-no-drag>
          {playlist.map(([title, artist, source], index) => (
            <li><button type="button" data-playlist-track data-playlist-source={source} data-playlist-index={index} aria-current={index === 0 ? "true" : undefined}><b>{index + 1}</b><span>{title}</span><em>{artist}</em></button></li>
          ))}
        </ol>
        <footer class="desktop__playlist-controls">
          <button class="desktop__playlist-previous" type="button" data-playlist-previous aria-label="Previous track"><i></i><i></i></button>
          <button class="desktop__playlist-play" type="button" data-playlist-play aria-label="Play"><i></i></button>
          <button class="desktop__playlist-next" type="button" data-playlist-next aria-label="Next track"><i></i><i></i></button>
        </footer>
        <i class="desktop__playlist-corner" aria-hidden="true"></i>
      </div>
    </section>
    <div class="desktop__sticker desktop__sticker--brand" data-draggable><BrandMark compact /></div>

    <DesktopWindow id="about" title="About me">
      <div slot="about">
        <AboutPanel />
      </div>
      <WorksPanel slot="works" />
      <ContactPanel slot="contact" />
    </DesktopWindow>
  </div>
</main>

<style>
  .desktop { position: fixed; inset: 0 0 var(--footer-height); overflow: hidden; background: var(--color-canvas); }
  .desktop__stage { position: relative; width: 100%; height: 100%; }
  .desktop__playlist[data-draggable], .desktop__playlist[data-draggable]:active { position: absolute; top: calc(16% + 1.36rem); left: 1%; z-index: 1; width: min(20.45vw, 392.581px); min-width: 16rem; aspect-ratio: 392.581 / 260.426; cursor: default; user-select: none; }
  .desktop__playlist::before { position: absolute; inset: 9.562% 1.102% 1.91% 10.585%; border-radius: 14.247px; content: ""; background: var(--color-mint); }
  .desktop__playlist-card { position: absolute; inset: 1.909% 4.481% 8.068% 5.564%; overflow: hidden; border-radius: 14.247px; color: var(--color-purple); background: var(--color-purple); cursor: default; touch-action: none; }
  .desktop__playlist-header { position: absolute; z-index: 3; top: 6.567%; right: 4.656%; display: flex; align-items: center; gap: 16.27px; color: var(--color-mint); font: 700 8px/1 var(--font-mono); cursor: grab; touch-action: none; }
  .desktop__playlist-header:active { cursor: grabbing; }
  .desktop__playlist-header b { display: block; width: 13.959px; aspect-ratio: 1; background: var(--color-mint); }
  .desktop__playlist-record { position: absolute; z-index: 1; top: 12.383%; left: -20.91%; width: 51.735%; aspect-ratio: 1; border: 0; border-radius: 50%; background: var(--color-ink); box-shadow: 0 0 0 4px var(--color-purple), 0 0 0 6px var(--color-mint); }
  .desktop__playlist-record::after { position: absolute; z-index: 1; top: 5.78%; left: 78.74%; width: 7px; aspect-ratio: 1; border-radius: 50%; content: ""; background: var(--color-mint); translate: -50% -50%; }
  .desktop__playlist-record i { position: absolute; top: 50%; left: 50%; width: 27.415%; aspect-ratio: 1; border-radius: 50%; background: var(--color-mint); translate: -50% -50%; }
  .desktop__playlist-card[data-playing="true"] .desktop__playlist-record { animation: playlist-record-spin 6s linear infinite; }
  .desktop__playlist h2 { position: absolute; z-index: 2; top: 16.5%; left: 38.1%; margin: 0; color: var(--color-mint); font: 700 clamp(.8rem, 1vw, 1.15rem)/1.22 var(--font-mono); letter-spacing: .02em; }
  .desktop__playlist-list { position: absolute; z-index: 2; top: 41%; left: 38.5%; width: 48.1%; height: 34.6%; margin: 0; padding: 0 .3rem 0 0; overflow-x: hidden; overflow-y: auto; list-style: none; scrollbar-width: thin; scrollbar-color: var(--color-mint) transparent; cursor: auto; touch-action: pan-y; }
  .desktop__playlist-list::-webkit-scrollbar { display: block; width: 3px; }
  .desktop__playlist-list::-webkit-scrollbar-thumb { min-height: .9rem; border: 0; border-radius: 999px; background: var(--color-mint); }
  .desktop__playlist-list li { height: 20%; min-height: 16px; }
  .desktop__playlist-list li button { display: grid; grid-template-columns: 24px max-content minmax(0, 1fr); width: 100%; height: 100%; padding: 0; border: 0; align-items: center; column-gap: 0; color: var(--color-ink); background: transparent; font: 400 11px/1 var(--font-sans); text-align: left; white-space: nowrap; cursor: pointer; }
  .desktop__playlist-list li button > b { color: var(--color-mint); font: 700 11px/1 var(--font-mono); }
  .desktop__playlist-list li button > span { overflow: hidden; text-overflow: ellipsis; }
  .desktop__playlist-list li button > span::after { content: " ·"; color: #C9A4FC; font-size: 12px; }
  .desktop__playlist-list li button > em { min-width: 0; margin-left: 6px; overflow: hidden; color: #C9A4FC; font-style: normal; text-overflow: ellipsis; }
  .desktop__playlist-list li button[aria-current="true"] { color: var(--color-mint); }
  .desktop__playlist-controls { position: absolute; z-index: 2; right: 12.78%; bottom: 11.67%; left: 39.13%; display: flex; align-items: center; justify-content: space-between; }
  .desktop__playlist-controls > button { display: flex; padding: 0; border: 0; align-items: center; background: transparent; cursor: pointer; }
  .desktop__playlist-controls > button:not(.desktop__playlist-play) { gap: -1px; }
  .desktop__playlist-controls > button i { display: block; width: 0; height: 0; }
  .desktop__playlist-previous i { border-top: 5.36px solid transparent; border-right: 8.93px solid var(--color-mint); border-bottom: 5.36px solid transparent; }
  .desktop__playlist-next i { border-top: 5.36px solid transparent; border-bottom: 5.36px solid transparent; border-left: 8.93px solid var(--color-mint); }
  .desktop__playlist-play { display: grid !important; place-items: center; width: 19.14px; aspect-ratio: 1; border-radius: 50% !important; background: var(--color-mint) !important; }
  .desktop__playlist-play i { width: 0; height: 0; margin-left: 1px; border-top: 3.27px solid transparent; border-bottom: 3.27px solid transparent; border-left: 5.46px solid var(--color-purple); }
  .desktop__playlist-card[data-playing="true"] .desktop__playlist-play i { width: 5px; height: 7px; margin-left: 0; border: 0; border-right: 2px solid var(--color-purple); border-left: 2px solid var(--color-purple); }
  .desktop__playlist-corner { position: absolute; right: 4.656%; bottom: 6.13%; width: 13.959px; aspect-ratio: 1; background: var(--color-mint); }
  .desktop__sticker { position: absolute; z-index: 2; user-select: none; touch-action: none; cursor: grab; }
  .desktop__sticker--brand { left: 8%; bottom: 18%; scale: 1.2; rotate: -12deg; }
  .desktop__sticker--eyes { right: 6%; top: 35%; width: 6.5rem; rotate: 20deg; }
  @media (min-width: 48.01rem) and (min-resolution: 120dpi) and (max-resolution: 143dpi) { .desktop__playlist[data-draggable] { scale: 1.25; transform-origin: top left; } }
  @keyframes playlist-record-spin { to { transform: rotate(360deg); } }
  @media (max-width: 48rem) { .desktop__playlist, .desktop__sticker { display: none; } }
</style>
